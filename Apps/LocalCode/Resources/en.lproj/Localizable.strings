"second_pass_strength" = "2nd Pass Strength";

"hires_fix_detail" = "Hi-res Fix uses your selected size for first pass image generation, then applies image-to-image generation at the selected strength for refinement to reach the target size. It avoids duplicate objects when generating directly and tends to generate more details than when using a generic upscaler.";

"torch_cpu_compatible" = "Torch CPU Compatible";

