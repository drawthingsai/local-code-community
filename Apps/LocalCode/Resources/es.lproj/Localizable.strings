"machine_settings"= "Configuraciones de la máquina";

"prefill_warmup" = "Calentamiento del prellenado";

"prefill_warmup_detail" = "Prepara el modelo local seleccionado antes del primer prompt para acelerar su procesamiento. El calentamiento puede aumentar brevemente el uso de memoria o retrasar la primera respuesta justo después de iniciar la aplicación. Activado de forma predeterminada en Macs con al menos 128 GiB de memoria; en otros dispositivos debe activarse manualmente. Los cambios se aplican al iniciar la aplicación o seleccionar un modelo.";

"key_model_memory_for_sd_sdxl" = "Mantener el modelo en memoria para SD 1.5 y SDXL";

"automatic_yes"= "Automático (Sí)";

"automatic_no"= "Automático (No)";

"efficient_model_loading" = "Por defecto, descargamos el modelo después de la generación de imágenes y lo volvemos a cargar cuando se genera de nuevo. La carga del modelo puede tardar entre 2 y 5 segundos cada vez. Al habilitar esto, mantendremos el modelo en memoria para una generación más rápida y solo lo descargaremos cuando el sistema operativo nos indique que estamos quedando sin memoria. Opcionalmente, puede precargar solo el modelo CoreML, lo que amortiza el tiempo de carga del modelo de CoreML y no ocupa memoria de otro modo.";

"coreml_if_possible" = "Usar CoreML para SD 1.5 si es posible";

"coreml_memory_usage" = "CoreML consume más memoria y no es aplicable para muchos dispositivos móviles. Incurre ~70 segundos de tiempo para cargar la primera vez. Pero a cambio, es aproximadamente un 50% más rápido. Es mejor habilitar 'Mantener modelo en memoria - Precarga' junto con esto para amortizar la carga de la primera vez.";

"coreml_for_lora"= "Usar CoreML con LoRA para SD 1.5";

"coreml_lora_detail"= "Para modelos LoRA, se puede aprovechar CoreML. Sin embargo, cada cambio en los pesos, diferentes modelos LoRA o sus combinaciones generarán un nuevo modelo CoreML, lo que conlleva la compilación del modelo, que puede durar minutos.";

"file_swap_weights" = "Cambiar Pesos de Archivo";

"file_swap_detail" = "La operación principal de Stable Diffusion requiere al menos 1,7 GiB para parámetros, los dispositivos móviles con 3 GiB de RAM tendrán dificultades para cargar solo los parámetros. Esta opción nos permite descargar estos parámetros al disco y cargarlos solo cuando sea necesario. Para dispositivos más lentos, esto no será un cuello de botella, pero para dispositivos más rápidos, puede serlo. Se requiere espacio adicional en el disco y seleccionar 'Nunca' forzará a eliminar estos archivos de parámetros.";

"automatic_sometimes" = "Automático (A veces)";

"screen_saver" = "Protector de Pantalla";

"screen_saver_detail" = "En dispositivos móviles, la aplicación debe estar en primer plano para continuar con la generación de imágenes. El uso excesivo con un brillo de pantalla alto puede causar efectos duraderos en la pantalla OLED (que generalmente se ven en los modelos iPhone Pro). El protector de pantalla disminuirá el brillo de la pantalla durante la generación de imágenes para evitar el efecto potencialmente negativo.";

"temporary_directory" = "Directorio Temporal";

"temporary_directory_detail" = "Debido a cómo funciona el mecanismo interno del sistema operativo, 'Draw Things' puede generar archivos temporales excesivos en el directorio tmp. Estos archivos se eliminarán automáticamente cuando el sistema operativo esté bajo en espacio en disco. Pero también puedes usar esto para limpiarlo explícitamente si estás bajo en espacio en disco.";

"cleanup" = "Limpieza";

"reset_to_default" = "Restablecer a los valores predeterminados";

"seed_explain" = "El valor de semilla determina cómo comienza la generación de imágenes. La misma semilla generará la misma imagen.";

"seed_mode" = "Modo de Semilla";

"seed_mode_detail" = "El modo de semilla determina cómo se utiliza la semilla. \"Herencia\" es compatible con la versión anterior de la aplicación Draw Things, \"Compatible con GPU NVIDIA\" es compatible con otras herramientas de escritorio como AUTOMATIC1111 o Invoke.AI en GPU NVIDIA / Linux / Windows, \"Compatible con Torch CPU\" es compatible con otras herramientas de escritorio en macOS y \"Mantener Escala\" permite que la semilla mantenga cierta similitud incluso en diferentes tamaños de imagen.";

"legacy" = "Legacy";

"image_size" = "Tamaño de Imagen";

"image_size_detail" = "El tamaño de la imagen generada. Para obtener mejores resultados, utilice 1:1/Normal.";

"final_output_size" = "Tamaño de Salida Final";

"upscaler_detail" = "El Upscaler puede ayudar a generar imágenes de alta resolución visualmente agradables (2048x2048) a partir de una imagen relativamente más pequeña (512x512). Dependiendo del Upscaler que se utilice, puede llenar con diferentes detalles e introducir estilos ligeramente diferentes.";

"steps_detail" = "Cantidad de pasos que se deben aplicar para la generación de imágenes. Cuantos más pasos, mejor será la imagen, pero tomará más tiempo.";

"text_guidance_detail" = "Cómo se debe tratar la entrada de texto \"literalmente\". Un valor más alto sería más fiel al texto, mientras que un valor más bajo tendría más libertad artística. (CFG Scale)";

"text_to_image" = "Texto a Imagen";

"image_to_image" = "Imagen a Imagen";

"strength_detail" = "Al generar desde una imagen, un valor alto daría más libertad artística a partir de la imagen original. El 100% significa que no hay influencia de la imagen existente (también conocido como texto a imagen).";

"dpm_2m_karras" = "DPM++ 2M Karras";

"sampler_detail" = "Diferentes samplers pueden converger en diferentes pasos y pueden resultar en diferentes estilos visuales. Se sabe que Euler A genera imágenes más \"oníricas\", mientras que DPM++ 2M Karras puede generar imágenes de alta calidad en no más de 30 pasos.";

"image_guidance_detail" = "Los modelos de edición utilizan la imagen como guía al igual que el texto. Este valor, junto con la guía de texto, determina cómo el modelo puede divergir de cualquiera de los dos. Una guía de imagen más alta sería más fiel a la imagen original.";

"clip_skip" = "Omitir CLIP";

"clip_skip_detail" = "\"Omitir CLIP\" controla cuántas capas se omiten en el codificador de texto. El codificador de texto traduce su texto a vectores que la computadora entiende. Saltarse más capas en el codificador de texto obligará a la computadora a centrarse más en palabras individuales que en sus significados combinados. Esto podría ser útil para modelos que se afinan en entradas de texto similares a etiquetas.";

"mask_blur" = "Desenfoque de Máscara";

"mask_blur_detail" = "\"Desenfoque de Máscara\" intenta hacer que la máscara sea un poco más suave en el borde, lo que puede ayudar a mezclarse con el resto de la imagen.";

"face_restoration_detail" = "La restauración facial puede utilizar un modelo adicional para corregir los rostros pequeños distorsionados durante la generación de imágenes. Este proceso funciona mejor para imágenes fotorealistas. Para imágenes de anime o artísticas, esto puede no ser deseable.";

"batch_size_detail" = "Cuántas imágenes se generarán a la vez.";

