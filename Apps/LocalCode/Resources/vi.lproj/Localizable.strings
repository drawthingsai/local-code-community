"8bit_lora_detail" = "Mô hình LoRA có thể chiếm hàng trăm MiB. Mô hình lượng tử hóa ~8-bit chỉ chiếm khoảng một nửa dung lượng đó với khác biệt hình ảnh rất nhỏ. Bạn có thể tạo mô hình lượng tử hóa 8-bit, so sánh kết quả với bản gốc, và nếu hài lòng với kết quả lượng tử hóa, hãy xóa mô hình gốc để tiết kiệm dung lượng ổ đĩa. Việc tạo mô hình lượng tử hóa 8-bit sẽ mất khoảng 1 đến 5 phút tùy thiết bị của bạn, bạn có muốn tiếp tục không?";

"base_model_detail" = "LoRA là một mô hình bổ sung. Nó cần một mô hình cơ sở và được tinh chỉnh từ đó. Một mô hình cơ sở tốt có thể giảm số bước cần thiết và mang lại tính thẩm mỹ cao hơn cho kết quả cuối cùng.";

"output_lora_name_detail" = "Tên của LoRA sẽ hiển thị trong danh sách LoRA. Chúng tôi cũng lưu các thông tin liên quan đến quá trình huấn luyện, như siêu tham số và chú thích của tập dữ liệu huấn luyện, với tên này. Nếu bạn dùng cùng một tên, chúng tôi sẽ có thể khôi phục các thông tin này.";

"trigger_word_detail" = "Từ kích hoạt giúp điền từ kích hoạt vào chú thích và mang lại cho LoRA một điểm khởi đầu tốt. Bạn nên chọn một từ kích hoạt không mang ý nghĩa đặc biệt mạnh đối với mô hình, nếu không nó có thể xóa khái niệm gốc khỏi mô hình.";

"network_dim_detail" = "\"Số chiều mạng\" quyết định năng lực của mạng LoRA. Giá trị lớn hơn sẽ cần nhiều dữ liệu hơn để huấn luyện nhưng có thể nắm bắt được nhiều sắc thái hơn của dữ liệu huấn luyện.";

"network_scale_detail" = "Đây là \"Network Alpha\" / \"Network Dim\" trong các trình huấn luyện khác. Giá trị này quyết định mức ảnh hưởng ban đầu của các trọng số ngẫu nhiên trong mạng LoRA. Tỷ lệ nhỏ hơn có thể giúp quá trình huấn luyện ổn định hơn.";

"training_image_size_detail" = "Độ phân giải khi huấn luyện mạng. Chúng tôi cắt phần giữa và thay đổi kích thước ảnh được cung cấp về độ phân giải này. Hãy đảm bảo dữ liệu huấn luyện lớn hơn hoặc bằng độ phân giải này, nếu không mạng có thể học cả các lỗi hình ảnh do phóng to.";

"training_steps_detail" = "Số bước huấn luyện cần thực hiện. Giá trị này cần được điều chỉnh cùng với tốc độ học để tạo ra mô hình tốt. Tốc độ học thấp hơn hoặc năng lực mạng lớn hơn sẽ cần nhiều bước huấn luyện hơn.";

"save_every_n_steps_detail" = "Tùy chọn này cho phép lưu LoRA sau mỗi n bước để tránh huấn luyện mô hình quá mức.";

"warmup_steps_detail" = "Tùy chọn này quyết định từ bước nào chúng tôi sẽ dùng toàn bộ tốc độ học để huấn luyện. Các bước khởi động giúp ổn định động lực huấn luyện sớm hơn bằng cách tránh đặt nặng các mẫu ban đầu.";

"gradient_accumulation_steps_detail" = "Tùy chọn này quyết định khi nào thực hiện cập nhật mạng. Tích lũy nhiều gradient hơn trước khi cập nhật giúp mạng có thêm thông tin thống kê về hướng cần đi. Bạn nên điều chỉnh tốc độ học theo giá trị này (ví dụ: số bước tích lũy gấp 2 thì tốc độ học gấp 2).";

"cotrain_text_model_detail" = "Có tinh chỉnh bộ mã hóa văn bản hay không. Với các mô hình SD v1 / v2, tinh chỉnh bộ mã hóa văn bản sẽ giúp đưa một khái niệm vào mô hình nhanh hơn. Điều này thường không cần thiết khi tinh chỉnh SDXL.";

"text_model_learning_rate_detail" = "Tốc độ học để tinh chỉnh bộ mã hóa văn bản.";

"noise_offset_detail" = "\"Offset noise\" thêm một độ lệch vào phân phối nhiễu. Điều này giúp tinh chỉnh mô hình để thể hiện tốt hơn các cảnh tối / sáng thay vì luôn rơi vào mức phơi sáng trung bình.";

"denoising_schedule_detail" = "Tùy chọn này quyết định giai đoạn nào của quá trình khử nhiễu sẽ được tập trung tinh chỉnh. Ví dụ: bạn có thể huấn luyện một LoRA giúp \"hoàn thiện\" ảnh bằng cách chỉ tập trung vào lịch khử nhiễu từ 70% đến 100%. Hoặc một LoRA giúp có bố cục tốt ở lịch từ 0% đến 50%.";

