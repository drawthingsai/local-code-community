"file_swap_weights" = "Hoán đổi trọng số qua tệp";

"file_swap_detail" = "Phép toán cốt lõi của Stable Diffusion cần ít nhất 1,7GiB cho các tham số. Thiết bị di động có 3GiB RAM có thể gặp khó khăn khi tải các tham số này. Tùy chọn này cho phép chuyển các tham số này xuống ổ đĩa và chỉ tải khi cần. Với thiết bị chậm hơn, đây sẽ không phải là điểm nghẽn, nhưng với thiết bị nhanh hơn thì có thể. Tùy chọn này cần thêm dung lượng ổ đĩa, và chọn 'Không bao giờ' sẽ buộc chúng tôi xóa các tệp tham số này.";

"automatic_sometimes" = "Tự động (Đôi khi)";

"screen_saver" = "Trình bảo vệ màn hình";

"screen_saver_detail" = "Trên thiết bị di động, ứng dụng phải ở nền trước để tiếp tục tạo ảnh. Dùng điện thoại quá nhiều ở độ sáng màn hình cao có thể gây ảnh hưởng lâu dài lên màn hình OLED (thường thấy trên các mẫu iPhone Pro). Trình bảo vệ màn hình sẽ giảm độ sáng màn hình trong khi tạo ảnh để tránh các tác động tiêu cực có thể xảy ra.";

"temporary_directory" = "Thư mục tạm";

"temporary_directory_detail" = "Do cách hệ điều hành hoạt động bên trong, 'Local Code' có thể tạo ra quá nhiều tệp tạm trong thư mục tạm. Các tệp này sẽ tự động bị xóa khi hệ điều hành sắp hết dung lượng ổ đĩa. Tuy nhiên, bạn cũng có thể dùng tùy chọn này để chủ động dọn dẹp nếu sắp hết dung lượng ổ đĩa.";

"cleanup" = "Dọn dẹp";

"reset_to_default" = "Đặt lại về mặc định";

"seed_explain" = "Giá trị seed quyết định cách bắt đầu quá trình tạo ảnh. Cùng một seed sẽ tạo ra cùng một ảnh.";

"seed_explain_cli" = "Giá trị seed quyết định cách bắt đầu quá trình tạo ảnh. Cùng một seed sẽ tạo ra cùng một ảnh. Lưu ý rằng truyền -1 làm seed sẽ tạo ra một giá trị ngẫu nhiên.";

"seed_mode" = "Chế độ seed";

"seed_mode_detail" = "Chế độ seed quyết định cách sử dụng seed. \"Kiểu cũ\" tương thích với ứng dụng Draw Things phiên bản cũ, \"Tương thích NVIDIA GPU\" tương thích với các công cụ máy tính để bàn khác như AUTOMATIC1111 hoặc Invoke.AI trên NVIDIA GPU / Linux / Windows, \"Tương thích Torch CPU\" tương thích với các công cụ máy tính để bàn khác trên macOS, và \"Tương đồng theo tỷ lệ\" cho phép seed giữ được phần nào sự tương đồng ngay cả ở các kích thước ảnh khác nhau.";

"legacy" = "Kiểu cũ";

"image_size" = "Kích thước ảnh";

"image_size_detail" = "Kích thước của ảnh được tạo. Để có kết quả tốt nhất, hãy dùng 1:1 / Bình thường";

"final_output_size" = "Kích thước đầu ra cuối cùng";

"upscaler_detail" = "Upscaler có thể giúp tạo ảnh độ phân giải cao đẹp mắt (ví dụ: 2048x2048) từ một ảnh tương đối nhỏ hơn (ví dụ: 512x512). Tùy vào upscaler bạn dùng, nó có thể bổ sung các chi tiết khác nhau và tạo ra phong cách hơi khác.";

"steps_detail" = "Số bước được áp dụng để tạo ảnh. Dùng nhiều bước hơn sẽ cho ảnh tốt hơn nhưng mất nhiều thời gian hơn.";

"text_guidance_detail" = "Mức độ bám sát \"nghĩa đen\" của văn bản đầu vào. Giá trị cao hơn sẽ trung thành với văn bản hơn, còn giá trị thấp hơn cho phép tự do nghệ thuật hơn. (CFG Scale)";

"text_guidance_detail_cli" = "Mức độ bám sát \"nghĩa đen\" của văn bản đầu vào. Cao hơn sẽ trung thành với văn bản hơn, thấp hơn sẽ tự do nghệ thuật hơn. (CFG Scale). Lưu ý rằng giá trị mặc định sẽ đổi thành 0.7 nếu ở chế độ ảnh sang ảnh.";

