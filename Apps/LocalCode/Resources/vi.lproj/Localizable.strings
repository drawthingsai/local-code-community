"clip_skip" = "Bỏ qua CLIP";

"clip_skip_detail" = "\"Bỏ qua CLIP\" kiểm soát số lớp bị bỏ qua, tính từ lớp cuối cùng trong bộ mã hóa văn bản. Bộ mã hóa văn bản chuyển văn bản của bạn thành các vectơ mà máy tính hiểu được. Bỏ qua nhiều lớp hơn trong bộ mã hóa văn bản sẽ buộc máy tính tập trung nhiều hơn vào từng từ riêng lẻ thay vì ý nghĩa kết hợp của chúng. Điều này có thể hữu ích cho các mô hình được tinh chỉnh trên văn bản đầu vào dạng thẻ (tag).";

"mask_blur" = "Làm mờ mặt nạ";

"mask_blur_detail" = "\"Làm mờ mặt nạ\" cố gắng làm mềm cạnh của mặt nạ một chút, có thể giúp hòa trộn với phần còn lại của ảnh.";

"face_restoration_detail" = "Phục hồi khuôn mặt có thể dùng thêm một mô hình để sửa các khuôn mặt nhỏ, bị méo trong quá trình tạo ảnh. Quá trình này hiệu quả nhất với ảnh chân thực. Với ảnh anime hoặc ảnh nghệ thuật, điều này có thể không như mong muốn.";

