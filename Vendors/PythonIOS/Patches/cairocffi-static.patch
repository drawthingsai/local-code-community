+# Compiled CFFI entry points use Cairo's closure argument for Python state.
+# No ffi.callback() executable trampolines are needed on iOS.
+@ffi.def_extern(name="_pythonios_cairo_read", error=constants.STATUS_READ_ERROR)
+def _read(closure, data, length):
+    string = ffi.from_handle(closure).read(length)
+    if len(string) != length:
+        return constants.STATUS_READ_ERROR
+    ffi.buffer(data, length)[:] = string
+    return constants.STATUS_SUCCESS
+
+
+@ffi.def_extern(name="_pythonios_cairo_write", error=constants.STATUS_WRITE_ERROR)
+def _write(closure, data, length):
+    if closure != ffi.NULL:
+        ffi.from_handle(closure).write(ffi.buffer(data, length))
+    return constants.STATUS_SUCCESS
+
+
+@ffi.def_extern(name="_pythonios_cairo_destroy")
+def _destroy(closure):
+    value = ffi.from_handle(closure)
+    value.instances.remove(value)
+
+
+def _make_read_handle(file_obj):
+    return ffi.new_handle(file_obj)
+
+
+def _make_write_handle(file_obj):
+    return ffi.NULL if file_obj is None else ffi.new_handle(file_obj)
 
 
