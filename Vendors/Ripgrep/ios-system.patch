+use std::{
+    ffi::{c_char, c_int, c_void, CString, OsString},
+    fmt,
+    io::{self, Read, Write},
+    os::unix::ffi::{OsStrExt, OsStringExt},
+    path::{Path, PathBuf},
+    sync::{
+        atomic::{AtomicBool, AtomicI32, Ordering},
+        Mutex, MutexGuard,
+    },
+};
+
+use termcolor::{Ansi, Buffer, ColorChoice, NoColor, WriteColor};
+
+extern "C" {
+    fn ios_getenv(name: *const c_char) -> *mut c_char;
+    fn ios_getstdin() -> c_int;
+    fn ios_getstdout() -> c_int;
+    fn ios_getstderr() -> c_int;
+    fn ios_isatty(fd: c_int) -> c_int;
+    #[link_name = "read"]
+    fn system_read(fd: c_int, buffer: *mut c_void, count: usize) -> isize;
+    #[link_name = "write"]
+    fn system_write(fd: c_int, buffer: *const c_void, count: usize) -> isize;
+}
+
+static INVOCATION_LOCK: Mutex<()> = Mutex::new(());
+static STDIN_FD: AtomicI32 = AtomicI32::new(0);
+static STDOUT_FD: AtomicI32 = AtomicI32::new(1);
+static STDERR_FD: AtomicI32 = AtomicI32::new(2);
+static STDERR_LOCK: Mutex<()> = Mutex::new(());
+
+/// Holds process-global state for one embedded ripgrep invocation.
+pub(crate) struct Invocation {
+    _guard: MutexGuard<'static, ()>,
+}
+
+impl Invocation {
+    pub(crate) fn begin() -> Invocation {
+        let guard =
+            INVOCATION_LOCK.lock().unwrap_or_else(|error| error.into_inner());
+        STDIN_FD.store(valid_fd(unsafe { ios_getstdin() }, 0), Ordering::SeqCst);
+        STDOUT_FD.store(
+            valid_fd(unsafe { ios_getstdout() }, 1),
+            Ordering::SeqCst,
+        );
+        STDERR_FD.store(
+            valid_fd(unsafe { ios_getstderr() }, 2),
+            Ordering::SeqCst,
+        );
+        Invocation { _guard: guard }
+    }
+}
+
+fn valid_fd(fd: c_int, fallback: c_int) -> c_int {
+    if fd < 0 { fallback } else { fd }
+}
+
+#[derive(Clone, Copy, Debug)]
+struct RawReader {
+    fd: c_int,
+}
+
+impl Read for RawReader {
+    fn read(&mut self, buffer: &mut [u8]) -> io::Result<usize> {
+        loop {
+            let result = unsafe {
+                system_read(
+                    self.fd,
+                    buffer.as_mut_ptr().cast::<c_void>(),
+                    buffer.len(),
+                )
+            };
+            if result >= 0 {
+                return Ok(result as usize);
+            }
+            let error = io::Error::last_os_error();
+            if error.kind() != io::ErrorKind::Interrupted {
+                return Err(error);
+            }
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct RawWriter {
+    fd: c_int,
+}
+
+impl RawWriter {
+    fn stdout() -> RawWriter {
+        RawWriter { fd: STDOUT_FD.load(Ordering::SeqCst) }
+    }
+
+    fn stderr() -> RawWriter {
+        RawWriter { fd: STDERR_FD.load(Ordering::SeqCst) }
+    }
+}
+
+impl Write for RawWriter {
+    fn write(&mut self, buffer: &[u8]) -> io::Result<usize> {
+        loop {
+            let result = unsafe {
+                system_write(
+                    self.fd,
+                    buffer.as_ptr().cast::<c_void>(),
+                    buffer.len(),
+                )
+            };
+            if result >= 0 {
+                return Ok(result as usize);
+            }
+            let error = io::Error::last_os_error();
+            if error.kind() != io::ErrorKind::Interrupted {
+                return Err(error);
+            }
+        }
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+#[derive(Debug)]
+pub(crate) enum StandardStream {
+    NoColor(NoColor<RawWriter>),
+    Ansi(Ansi<RawWriter>),
+}
+
+impl Write for StandardStream {
+    fn write(&mut self, buffer: &[u8]) -> io::Result<usize> {
+        match self {
+            StandardStream::NoColor(writer) => writer.write(buffer),
+            StandardStream::Ansi(writer) => writer.write(buffer),
+        }
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        match self {
+            StandardStream::NoColor(writer) => writer.flush(),
+            StandardStream::Ansi(writer) => writer.flush(),
+        }
+    }
+}
+
+impl WriteColor for StandardStream {
+    fn supports_color(&self) -> bool {
+        matches!(self, StandardStream::Ansi(_))
+    }
+
+    fn supports_hyperlinks(&self) -> bool {
+        matches!(self, StandardStream::Ansi(_))
+    }
+
+    fn set_color(&mut self, spec: &termcolor::ColorSpec) -> io::Result<()> {
+        match self {
+            StandardStream::NoColor(writer) => writer.set_color(spec),
+            StandardStream::Ansi(writer) => writer.set_color(spec),
+        }
+    }
+
+    fn set_hyperlink(
+        &mut self,
+        link: &termcolor::HyperlinkSpec,
+    ) -> io::Result<()> {
+        match self {
+            StandardStream::NoColor(writer) => writer.set_hyperlink(link),
+            StandardStream::Ansi(writer) => writer.set_hyperlink(link),
+        }
+    }
+
+    fn reset(&mut self) -> io::Result<()> {
+        match self {
+            StandardStream::NoColor(writer) => writer.reset(),
+            StandardStream::Ansi(writer) => writer.reset(),
+        }
+    }
+}
+
+pub(crate) fn stdout(choice: ColorChoice) -> StandardStream {
+    if uses_color(choice) {
+        StandardStream::Ansi(Ansi::new(RawWriter::stdout()))
+    } else {
+        StandardStream::NoColor(NoColor::new(RawWriter::stdout()))
+    }
+}
+
+fn uses_color(choice: ColorChoice) -> bool {
+    match choice {
+        ColorChoice::Always | ColorChoice::AlwaysAnsi => true,
+        ColorChoice::Auto => is_terminal_stdout(),
+        ColorChoice::Never => false,
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct BufferWriter {
+    color: bool,
+    printed: AtomicBool,
+    separator: Option<Vec<u8>>,
+    lock: Mutex<()>,
+}
+
+impl BufferWriter {
+    pub(crate) fn stdout(choice: ColorChoice) -> BufferWriter {
+        BufferWriter {
+            color: uses_color(choice),
+            printed: AtomicBool::new(false),
+            separator: None,
+            lock: Mutex::new(()),
+        }
+    }
+
+    pub(crate) fn separator(&mut self, separator: Option<Vec<u8>>) {
+        self.separator = separator;
+    }
+
+    pub(crate) fn buffer(&self) -> Buffer {
+        if self.color { Buffer::ansi() } else { Buffer::no_color() }
+    }
+
+    pub(crate) fn print(&self, buffer: &Buffer) -> io::Result<()> {
+        if buffer.is_empty() {
+            return Ok(());
+        }
+        let _guard = self.lock.lock().unwrap_or_else(|error| error.into_inner());
+        let mut writer = RawWriter::stdout();
+        if let Some(separator) = self.separator.as_ref() {
+            if self.printed.load(Ordering::Relaxed) {
+                writer.write_all(separator)?;
+                writer.write_all(b"\n")?;
+            }
+        }
+        writer.write_all(buffer.as_slice())?;
+        self.printed.store(true, Ordering::Relaxed);
+        Ok(())
+    }
+}
+
+pub(crate) fn stdin() -> impl Read {
+    RawReader { fd: STDIN_FD.load(Ordering::SeqCst) }
+}
+
+pub(crate) fn is_terminal_stdout() -> bool {
+    unsafe { ios_isatty(STDOUT_FD.load(Ordering::SeqCst)) != 0 }
+}
+
+pub(crate) fn is_readable_stdin() -> bool {
+    unsafe { ios_isatty(STDIN_FD.load(Ordering::SeqCst)) == 0 }
+}
+
+pub(crate) fn var_os(name: &str) -> Option<OsString> {
+    let name = CString::new(name).ok()?;
+    let value = unsafe { ios_getenv(name.as_ptr()) };
+    if value.is_null() {
+        return None;
+    }
+    let bytes = unsafe { std::ffi::CStr::from_ptr(value) }.to_bytes();
+    Some(OsString::from_vec(bytes.to_vec()))
+}
+
+/// ios_system runs commands for several sessions in one process, each with
+/// its own working directory (its PWD); the process-wide one belongs to
+/// whichever session last moved it. So a relative path is searched under the
+/// session directory, and shown as typed.
+#[derive(Clone, Debug, Default)]
+pub(crate) struct SessionPaths {
+    /// The session directory, ending in `/`.
+    directory: Option<Vec<u8>>,
+    /// Each joined path with the path as typed.
+    joined: Vec<(Vec<u8>, Vec<u8>)>,
+}
+
+impl SessionPaths {
+    pub(crate) fn new() -> SessionPaths {
+        let directory = var_os("PWD")
+            .map(OsString::into_vec)
+            .filter(|directory| directory.starts_with(b"/"))
+            .map(|mut directory| {
+                if !directory.ends_with(b"/") {
+                    directory.push(b'/');
+                }
+                directory
+            });
+        SessionPaths { directory, joined: vec![] }
+    }
+
+    /// Returns where to find `path`: under the session directory when it is
+    /// relative.
+    pub(crate) fn join(&mut self, path: &Path) -> PathBuf {
+        let typed = path.as_os_str().as_bytes();
+        let Some(directory) = self.directory.as_ref() else {
+            return path.to_path_buf();
+        };
+        if typed.is_empty() || typed.starts_with(b"/") {
+            return path.to_path_buf();
+        }
+        // `ignore` matches globs against a relative path with one leading
+        // "./" dropped, and against an absolute one relative to the session
+        // directory, so the joined path drops it too. "." walks as "./" does.
+        let typed = if typed == b"." { b"./".as_slice() } else { typed };
+        let mut joined = directory.clone();
+        joined.extend_from_slice(typed.strip_prefix(b"./").unwrap_or(typed));
+        self.joined.push((joined.clone(), typed.to_vec()));
+        PathBuf::from(OsString::from_vec(joined))
+    }
+
+    /// Returns how to show `path` when it lies under a joined path.
+    pub(crate) fn display(&self, path: &Path) -> Option<PathBuf> {
+        let bytes = path.as_os_str().as_bytes();
+        self.joined.iter().find_map(|(joined, typed)| {
+            let rest = bytes.strip_prefix(joined.as_slice())?;
+            if !rest.is_empty()
+                && !rest.starts_with(b"/")
+                && !joined.ends_with(b"/")
+            {
+                return None;
+            }
+            let mut shown = typed.clone();
+            shown.extend_from_slice(rest);
+            Some(PathBuf::from(OsString::from_vec(shown)))
+        })
+    }
+
+    /// Returns `err` with its paths shown as `display` shows them.
+    pub(crate) fn display_error(&self, err: ignore::Error) -> ignore::Error {
+        let shown = |path: PathBuf| self.display(&path).unwrap_or(path);
+        match err {
+            ignore::Error::Partial(errs) => ignore::Error::Partial(
+                errs.into_iter().map(|err| self.display_error(err)).collect(),
+            ),
+            ignore::Error::WithLineNumber { line, err } => {
+                let err = Box::new(self.display_error(*err));
+                ignore::Error::WithLineNumber { line, err }
+            }
+            ignore::Error::WithPath { path, err } => {
+                let err = Box::new(self.display_error(*err));
+                ignore::Error::WithPath { path: shown(path), err }
+            }
+            ignore::Error::WithDepth { depth, err } => {
+                let err = Box::new(self.display_error(*err));
+                ignore::Error::WithDepth { depth, err }
+            }
+            ignore::Error::Loop { ancestor, child } => ignore::Error::Loop {
+                ancestor: shown(ancestor),
+                child: shown(child),
+            },
+            // `walkdir` names the path in its message.
+            ignore::Error::Io(err) => {
+                const PREFIX: &str = "IO error for operation on ";
+                let message = err.to_string();
+                let shown = message.strip_prefix(PREFIX).and_then(|rest| {
+                    let (path, cause) = rest.split_once(": ")?;
+                    let path = self.display(Path::new(path))?;
+                    Some(format!("{PREFIX}{}: {cause}", path.display()))
+                });
+                match shown {
+                    Some(shown) => {
+                        ignore::Error::Io(io::Error::new(err.kind(), shown))
+                    }
+                    None => ignore::Error::Io(err),
+                }
+            }
+            err => err,
+        }
+    }
+}
+
+pub(crate) fn write_error(arguments: fmt::Arguments<'_>) {
+    let _guard =
+        STDERR_LOCK.lock().unwrap_or_else(|error| error.into_inner());
+    let mut writer = RawWriter::stderr();
+    let _ = writer.write_all(b"rg: ");
+    let _ = writer.write_fmt(arguments);
+    let _ = writer.write_all(b"\n");
+}
