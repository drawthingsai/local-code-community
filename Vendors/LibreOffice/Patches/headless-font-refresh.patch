+void PrintFontManager::reloadFontconfig()
+{
+    m_aFontInstallerTimer.Stop();
+    m_aCurrentRequests.clear();
+    m_aPreviousLangSupportRequests.clear();
+    m_aFontFileToFontID.clear();
+    m_aFonts.clear();
+    // Keep IDs monotonic so a stale selection cannot alias a new face.
+    initFontconfig();
+    countFontconfigFonts();
+}
