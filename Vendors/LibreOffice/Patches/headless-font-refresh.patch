--- a/vcl/unx/generic/gdi/freetypetextrender.cxx
+++ b/vcl/unx/generic/gdi/freetypetextrender.cxx
@@ -37,6 +37,35 @@
 #include <font/FontMetricData.hxx>
 
 #include <sallayout.hxx>
+#include <vcl/outdev.hxx>
+#include <vcl/rendercontext/AddFontSubstituteFlags.hxx>
+#include <unotools/fontdefs.hxx>
+#include <string.h>
+
+// Private static-host hook. No live document may span a configuration change.
+extern "C" void office_refresh_fonts(const char* const* families, const char* const* substitutes, size_t count, int reloadFonts)
+{
+    SolarMutexGuard guard;
+    if (reloadFonts)
+    {
+        OutputDevice::ImplClearAllFontData(true);
+        psp::PrintFontManager::get().reloadFontconfig();
+        FreetypeManager::get().ClearFontCache();
+        OutputDevice::ImplUpdateAllFontData(true);
+    }
+    OutputDevice::BeginFontSubstitution();
+    OutputDevice::RemoveFontsSubstitute();
+    for (size_t i = 0; i < count; ++i)
+        OutputDevice::AddFontSubstitute(OUString::fromUtf8(families[i]),
+            OUString::fromUtf8(substitutes[i]), AddFontSubstituteFlags::ALWAYS);
+    OutputDevice::EndFontSubstitution();
+}
+
+// Use the same localized family normalization as VCL font substitution.
+extern "C" char* office_font_search_name(const char* family)
+{
+    return strdup(GetEnglishSearchFontName(OUString::fromUtf8(family)).toUtf8().getStr());
+}
 
