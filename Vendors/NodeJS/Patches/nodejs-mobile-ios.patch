+    sccache = shutil.which("sccache")
+    if not sccache:
+        print("\033[91mError: \033[0m" + "NODEJS_MOBILE_SCCACHE is set but sccache is not on PATH")
+        sys.exit(1)
+    for _var in ("CC", "CXX", "CC_host", "CXX_host"):
